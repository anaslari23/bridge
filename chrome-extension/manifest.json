{
  "manifest_version": 3,
  "name": "Brigade Bridge Local Connector",
  "version": "0.1.0",
  "description": "Connect Chrome tabs to the local Brigade Bridge overlay.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1:7432/*", "http://localhost:7432/*"],
  "background": {"service_worker": "background.js"},
  "action": {
    "default_title": "Brigade Bridge",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
